---
// Small brand logos for profile and social links (paths from Simple Icons, CC0, except the blog pencil).
// `brand` colors the icon with the service color; otherwise it uses currentColor.
interface Props {
  name: 'orcid' | 'linkedin' | 'scholar' | 'youtube' | 'blog';
  brand?: boolean;
  class?: string;
}
const { name, brand = true, class: className = 'h-4 w-4' } = Astro.props;

