---
// Principal investigator card: photo, name, title, contact, links to the PI page and LinkedIn.
import { getEntry } from 'astro:content';
import BrandIcon from './BrandIcon.astro';
import { links, t } from '../i18n/ui';

interface Props {
  class?: string;
}
const { class: className = 'card-a-dark' } = Astro.props;
const pi = (await getEntry('members', 'seungho-han'))!.data;
---

<article class={`rounded-2xl p-6 shadow-2xl shadow-black/30 sm:p-7 ${className}`}>
  <p class="text-sm font-bold">{t('about.welcome')}</p>
  <div class="mt-4 flex gap-5">
    <img src={`/media/people/${pi.photo}.webp`} alt={pi.name.en} width="480" height="584" class="h-32 w-26 shrink-0 rounded-xl object-cover object-top shadow-lg" loading="lazy" />
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-white/70">{t('about.pi')}</p>
      <p class="mt-1 text-2xl font-bold">{pi.name.en} <span class="text-base font-medium text-white/70">Ph.D.</span></p>
      <p class="mt-1 text-sm leading-snug text-white/80">{t('about.pi.title')}</p>
    </div>
  </div>
  <dl class="mt-5 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
    <div><dt class="text-white/60">Email</dt><dd><a class="font-medium hover:underline" href={`mailto:${links.email}`}>{links.email}</a></dd></div>
    <div><dt class="text-white/60">{t('about.office')}</dt><dd class="font-medium">{t('about.office.value')}</dd></div>
  </dl>
  <div class="mt-5 flex flex-wrap gap-2">
    <a href={links.cv} class="rounded-md bg-white px-4 py-2 text-sm font-semibold text-brand-black transition hover:bg-brand-black hover:text-white">{t('members.seeMore')} →</a>
    <a href={links.linkedin} class="inline-flex items-center gap-2 rounded-md border border-white/50 py-2 pr-4 pl-2.5 text-sm font-semibold transition hover:bg-white/10">
      <span class="grid h-5 w-5 place-items-center rounded bg-white"><BrandIcon name={'linkedin'} class="h-3.5 w-3.5" /></span>
      LinkedIn
    </a>
  </div>
</article>
