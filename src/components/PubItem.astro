---
// One publication row: year, then title, authors (PI in bold) and venue on one line, with JCR and award badges.
// Badge colors are limited to gray (status), red (JCR rank) and blue (award).
import type { CollectionEntry } from 'astro:content';

interface Props {
  pub: CollectionEntry<'publications'>;
}
const p = Astro.props.pub.data;
// End the title and the author list with a period unless they already end with punctuation.
const stop = (t: string) => (/[.?!]$/.test(t) ? t : `${t}.`);
const title = stop(p.title);
const authors = stop(p.authors).replace(/Han, S\./g, '<b class="text-brand-navy">Han, S.</b>');
---

<li class="grid gap-x-6 gap-y-1 py-2.5 sm:grid-cols-[3.5rem_1fr]">
  <span class="font-mono text-sm leading-6 text-faint">{p.year}</span>
  <p class="text-sm leading-6">
    {p.status && <span class="mr-1.5 rounded bg-slate-200/70 px-1.5 py-0.5 text-xs font-semibold text-slate-600">{p.status}</span>}
    <span class="font-semibold text-ink">{title}</span>{' '}
    <span class="text-muted" set:html={authors} />{' '}
    <i class="font-semibold text-accent-deep">{p.venue}</i>{p.details && <span class="text-muted">, {p.details}</span>}
    {p.jcr && (
      <span class={`ml-1.5 inline-block rounded px-1.5 py-0.5 text-xs leading-4 font-semibold ${p.q1 ? 'bg-celos-red text-white' : 'bg-celos-red/10 text-celos-red'}`}>{p.jcr}</span>
    )}
    {p.award && <span class="ml-1.5 inline-block rounded bg-accent/10 px-1.5 py-0.5 text-xs leading-4 font-semibold text-accent-deep">🏅 {p.award}</span>}
  </p>
</li>
