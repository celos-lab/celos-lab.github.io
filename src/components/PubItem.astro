---
// One publication row: year, title (with status), authors (PI in bold), venue, JCR and award badges.
// Badge colors are limited to gray (status), red (JCR rank) and blue (award).
import type { CollectionEntry } from 'astro:content';

interface Props {
  pub: CollectionEntry<'publications'>;
}
const p = Astro.props.pub.data;
const authors = p.authors.replace(/Han, S\./g, '<b class="text-brand-navy">Han, S.</b>');
---

<li class="grid gap-x-6 gap-y-1 py-3 sm:grid-cols-[3.5rem_1fr]">
  <span class="font-mono text-sm text-faint">{p.year}</span>
  <div>
    <p class="font-semibold leading-snug">
      {p.status && <span class="mr-2 rounded bg-slate-200/70 px-1.5 py-0.5 text-xs font-semibold text-slate-600">{p.status}</span>}
      {p.title}
    </p>
    <p class="mt-1 text-sm text-muted" set:html={authors} />
    <p class="mt-1 text-sm">
      <i class="font-semibold text-accent-deep">{p.venue}</i>
      {p.details && <span class="text-muted">, {p.details}</span>}
      {p.jcr && (
        <span class={`ml-2 inline-block rounded px-1.5 py-0.5 text-xs font-semibold ${p.q1 ? 'bg-celos-red text-white' : 'bg-celos-red/10 text-celos-red'}`}>{p.jcr}</span>
      )}
      {p.award && <span class="ml-2 inline-block rounded bg-accent/10 px-1.5 py-0.5 text-xs font-semibold text-accent-deep">🏅 {p.award}</span>}
    </p>
  </div>
</li>
