---
// Holo-style heading: small uppercase label over a huge gradient title.
// On a .section-dark parent the colors switch automatically (see global.css).
// An accent bar beside the title runs to the section edge; the whole heading fades in when it scrolls into view.
interface Props {
  label?: string;
  title: string;
  align?: 'left' | 'right';
  as?: 'h1' | 'h2';
}
const { label, title, align = 'left', as: Tag = 'h2' } = Astro.props;
---

<div class={`reveal heading ${align === 'right' ? 'text-right' : ''}`}>
  {label && <p class="label">{label}</p>}
  <div class={`mt-1 flex items-center gap-4 sm:gap-6 ${align === 'right' ? 'flex-row-reverse' : ''}`}>
    <Tag class="display">{title}</Tag>
    <span class="heading-bar" aria-hidden="true"></span>
  </div>
</div>
