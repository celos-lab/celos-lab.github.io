---
// One research topic as a dark block: title, summary (bold/underline as on Notion), "Kor." toggle, numbered demo clips.
import type { CollectionEntry } from 'astro:content';
import Video from './Video.astro';
import { rich } from '../lib/emph';

interface Props {
  topic: CollectionEntry<'research'>;
}
const r = Astro.props.topic.data;
---

<article class="reveal block-dark rich p-5 sm:p-6">
  <h3 class="text-xl font-extrabold italic leading-tight sm:text-2xl">{r.order}. {r.title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-white/80 sm:text-base" set:html={`● ${rich(r.summary)}`} />
  <details class="group mt-3 text-sm text-white/70">
    <summary class="cursor-pointer list-none font-semibold select-none hover:text-white">
      <span class="inline-block transition group-open:rotate-90">▸</span> Kor.
    </summary>
    <p lang="ko" class="mt-2 leading-relaxed" set:html={rich(r.summaryKo)} />
  </details>
  <ol class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-2 lg:grid-cols-3">
    {r.demos.map((d, i) => (
      <li>
        <p class="mb-1.5 text-xs font-semibold leading-snug">{i + 1}. {d.caption}</p>
        <div class="aspect-video overflow-hidden rounded-lg bg-black ring-1 ring-white/10">
          <Video name={d.media} alt={d.caption} />
        </div>
      </li>
    ))}
  </ol>
</article>
