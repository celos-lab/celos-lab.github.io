---
import PiCard from '../PiCard.astro';
import Video from '../Video.astro';
import { t } from '../../i18n/ui';
import { rich } from '../../lib/emph';

const keywords = [
  'Sampling-based model predictive control',
  'Reinforcement learning',
  'Diffusion policy',
  'Autonomous driving/robot',
  'Sensor fusion',
  'AI edge controller',
];
---

<section id="about" class="section-dark relative overflow-hidden pt-20 pb-10 sm:pt-24 lg:pb-14">
  <!-- Background: montage of research demos, darkened (public/media/hero_bg.mp4) -->
  <div class="pointer-events-none absolute inset-0">
    <Video name="hero_bg" alt="" decorative class="scale-105 opacity-40 blur-[2px]" />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-black/55 via-brand-black/75 to-brand-black"></div>
    <div class="absolute inset-0 bg-[radial-gradient(900px_circle_at_50%_15%,rgb(0_32_96/0.55),transparent_65%)]"></div>
  </div>
  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col items-center text-center">
      <div class="flex items-center gap-5 sm:gap-9">
        <div class="flex flex-col items-center">
          <img src="/logo-white-lg.webp" fetchpriority="high" alt="CELOS" width="1280" height="240" class="w-[min(62vw,30rem)] sm:w-[min(46vw,30rem)]" />
          <p class="mt-3 font-mono text-[0.6rem] tracking-wide text-white/65 sm:text-sm">
            <b class="text-white">C</b>ontrol, <b class="text-white">E</b>stimation, and <b class="text-white">L</b>earning for <b class="text-white">O</b>ptimal <b class="text-white">S</b>ystems
          </p>
        </div>
        <span class="h-12 w-px bg-white/25 sm:h-20" aria-hidden="true"></span>
        <div class="flex flex-col items-center gap-1.5 md:flex-row md:gap-3">
          <img src="/media/logos/hanyang-emblem.png" alt="Hanyang University" title="Hanyang University" width="192" height="192" class="h-11 w-11 sm:h-[4.5rem] sm:w-[4.5rem]" />
          <p class="text-center text-[0.6rem] leading-tight font-semibold whitespace-nowrap text-white/85 sm:text-xs md:text-left md:text-sm lg:text-base">School of<br />Electrical Engineering</p>
        </div>
      </div>
      <h1 class="display mt-5 pr-[0.12em] italic !text-2xl sm:!text-3xl lg:!text-4xl">{t('hero.title')}</h1>
    </div>

    <div class="mt-6 grid items-start gap-5 md:grid-cols-2">
      <article class="card-b rich flex flex-col rounded-2xl border border-white/10 p-6 shadow-2xl shadow-black/30 sm:p-7">
        <p class="text-xs font-semibold uppercase tracking-wider text-white/60">{t('about.label')}</p>
        <p class="mt-3 text-sm leading-relaxed text-white/85">● {t('about.body')}</p>
        <p lang="ko" class="mt-2.5 text-sm leading-relaxed text-white/85" set:html={`● ${rich(t('about.bodyKo'))}`} />
        <p class="mt-5 text-xs font-bold text-white/60">[{t('about.keywords')}]</p>
        <ul class="mt-2 flex flex-wrap gap-2">
          {keywords.map((k) => <li class="rounded-full border border-white/25 px-3 py-1 text-xs">{k}</li>)}
        </ul>
      </article>
      <PiCard />
    </div>
  </div>
</section>
