---
// Recruiting block in the Research Goals grid (fourth cell, PI decision 2026-11-15); the header "Join us" button links to #join.
import BrandIcon from '../BrandIcon.astro';
import { joinForm, links, t } from '../../i18n/ui';
import { rich } from '../../lib/emph';
---

<article id="join" class="card-b rich relative scroll-mt-20 overflow-hidden rounded-2xl p-5 shadow-2xl shadow-black/50 sm:p-6">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(400px_circle_at_90%_10%,rgb(91_139_224/0.35),transparent_60%)]"></div>
  <div class="relative">
    <p class="label">{t('join.label')}</p>
    <h3 class="mt-1 text-xl font-extrabold leading-tight tracking-tight sm:text-2xl">{t('join.title')}</h3>
    <p lang="ko" class="mt-3 text-sm text-white/80 sm:text-base" set:html={`■ ${rich(t('join.bodyKo'))}`} />
    <p class="mt-2 text-sm text-white/80 sm:text-base" set:html={`■ ${rich(t('join.body'))}`} />
    <div class="mt-5 flex flex-wrap gap-3">
      <a href={joinForm.ko} lang="ko" class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-brand-black transition hover:bg-accent-soft hover:text-white">{t('join.cta.ko')} →</a>
      <a href={joinForm.en} class="rounded-md border border-white/40 px-5 py-2.5 text-sm font-semibold transition hover:bg-white/10">{t('join.cta.en')} →</a>
    </div>
    <div class="mt-5 border-t border-white/15 pt-4">
      <p class="text-sm font-bold italic">💡 {t('research.more')}</p>
      <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-white/80">
        <li><a href={links.youtube} class="inline-flex items-center gap-1.5 hover:text-white"><BrandIcon name="youtube" /> YouTube <b>CELOS Lab</b></a></li>
        <li><a href={links.blog} class="inline-flex items-center gap-1.5 hover:text-white"><BrandIcon name="blog" /> <b>CELOS Lab. Tech Blog</b></a></li>
      </ul>
    </div>
  </div>
</article>
