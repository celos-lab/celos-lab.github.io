---
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import BrandIcon from '../BrandIcon.astro';
import TopicBlock from '../TopicBlock.astro';
import { links, t } from '../../i18n/ui';

const [t1, t2, t3] = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const history = (await getCollection('history')).sort((a, b) => a.data.order - b.data.order);
const partnerGroups = [
  {
    label: t('partners.domestic'),
    items: [
      { name: 'Korea Institute of Machinery & Materials (KIMM)', logo: 'kimm' },
      { name: 'KAIST', logo: 'kaist' },
    ],
  },
  {
    label: t('partners.international'),
    items: [
      { name: 'NVIDIA', logo: 'nvidia' },
      { name: 'University of Michigan', logo: 'umich' },
      { name: 'University of Minnesota', logo: 'umn' },
    ],
  },
];
---

<section id="research" class="section-dark section-lift">
  <div class="mx-auto max-w-7xl px-5 py-10 sm:px-8 lg:py-14">
    <SectionHeading title={t('research.title')} />

    <div class="mt-6 grid items-start gap-5 md:grid-cols-2">
      <TopicBlock topic={t1} />
      <TopicBlock topic={t2} />

      <TopicBlock topic={t3} />

      <article id="partners" class="block-dark p-5 sm:p-6">
        <h3 class="bar">{t('partners.label')}</h3>
        <div class="mt-4 grid gap-5 rounded-xl bg-white p-5 text-brand-black sm:grid-cols-[1fr_1.4fr] md:grid-cols-1 lg:grid-cols-[1fr_1.4fr]">
          {partnerGroups.map((g) => (
            <div>
              <p class="text-sm font-bold">• {g.label}</p>
              <ul class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3">
                {g.items.map((p) => (
                  <li><img src={`/media/logos/${p.logo}.png`} alt={p.name} title={p.name} class="h-8 w-auto object-contain sm:h-9" loading="lazy" /></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="mt-5 border-t border-white/10 pt-4">
          <p class="text-sm font-bold italic">💡 {t('research.more')}</p>
          <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-white/80">
            <li><a href={links.youtube} class="inline-flex items-center gap-1.5 hover:text-white"><BrandIcon name="youtube" /> YouTube <b>CELOS Lab</b></a></li>
            <li><a href={links.blog} class="inline-flex items-center gap-1.5 hover:text-white"><BrandIcon name="blog" /> <b>CELOS Lab. Tech Blog</b></a></li>
          </ul>
        </div>
      </article>
    </div>

    <article id="etc" class="block-dark mt-5 p-5">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <h3 class="bar">{t('history.title')}</h3>
        <p class="text-sm text-white/60">{t('history.subtitle')}</p>
      </div>
      <ul class="mt-4 grid grid-cols-3 gap-2 sm:gap-3 lg:grid-cols-6">
        {history.map((h) => (
          <li class="overflow-hidden rounded-xl border border-white/10 bg-[#3a3a3a]">
            <div class="aspect-[4/3] overflow-hidden bg-white">
              <img src={`/media/etc/${h.data.image}.webp`} alt={h.data.title} class="h-full w-full object-cover" loading="lazy" />
            </div>
            <div class="p-2.5">
              <p class="text-xs font-semibold leading-snug">{h.data.title}</p>
              <p class="mt-1 text-[0.7rem] text-white/60">{h.data.period}, {h.data.institute}</p>
            </div>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>
