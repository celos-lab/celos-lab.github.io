---
import '../styles/global.css';
import BrandIcon from '../components/BrandIcon.astro';
import { links, t } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  extraJsonLd?: Record<string, unknown>[];
}

// Default share image: public/og.jpg (1200x630, built by a one-off script from the logo and the Hanyang emblem).
const { title, description, image = '/og.jpg', extraJsonLd = [] } = Astro.props;
const pageTitle = title ? `${title} | CELOS Lab` : t('site.title');
const pageDescription = description ?? t('site.description');
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);

// Links start with "/" so they also work from the PI page; `id` drives the active-item highlight.
const nav = [
  { id: 'about', href: '/#about', label: t('nav.about') },
  { id: 'news', href: '/#news', label: t('nav.news') },
  { id: 'pi', href: links.cv, label: t('nav.pi') },
  { id: 'members', href: '/#members', label: t('nav.members') },
  { id: 'achievements', href: '/#achievements', label: t('nav.achievements') },
  { id: 'projects', href: '/#projects', label: t('nav.projects') },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ResearchOrganization',
    name: 'CELOS Lab (Control, Estimation, and Learning for Optimal Systems)',
    alternateName: ['CELOS', 'CELOS 연구실'],
    url: Astro.site?.href,
    logo: new URL('/logo-black.png', Astro.site).href,
    email: links.email,
    parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Hanyang University' },
    address: {
      '@type': 'PostalAddress',
      streetAddress: '55 Hanyangdaehak-ro, Engineering Building 3, Room 402',
      addressLocality: 'Ansan',
      addressRegion: 'Gyeonggi-do',
      addressCountry: 'KR',
    },
    founder: {
      '@type': 'Person',
      name: 'Seungho Han',
      alternateName: '한승호',
      jobTitle: 'Assistant Professor',
      affiliation: 'Hanyang University',
      sameAs: [links.linkedin],
    },
    sameAs: [links.youtube, links.blog],
  },
  ...extraJsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // `js` gates the scroll animations. Light is the default; `dark` only after the visitor picks it
      // with the header toggle (PI decision 2026-10-25).
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        if (saved === 'dark') d.classList.add('dark');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <!-- Search engine ownership checks (Google Search Console, Naver Search Advisor). -->
    <meta name="google-site-verification" content="XNMeIurV-Qu0EEqSxWQRhwlB1htdLcWjFhODy2jo9XA" />
    <meta name="naver-site-verification" content="2caa78c48ef86da11cad07923eec7dc758b8a61d" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-icon-180x180.png" />
    <meta name="theme-color" content="#191919" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CELOS Lab" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#top" class="sr-only z-[60] rounded-md bg-white px-4 py-2 font-semibold text-brand-black focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>
    <header id="top-bar" class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-brand-black/85 text-white backdrop-blur-md">
      <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8">
        <a href="/" class="flex items-center" aria-label="CELOS Lab">
          <img src="/logo-white.png" alt="CELOS" class="h-5 w-auto sm:h-6" width="720" height="164" />
        </a>
        <ul class="hidden items-center gap-7 text-sm font-medium text-white/65 lg:flex">
          {nav.map((n) => (
            <li>
              <a href={n.href} data-nav={n.id} aria-current={path === n.href ? 'page' : undefined} class="relative py-1 transition hover:text-white aria-[current=page]:font-semibold aria-[current=page]:text-white">
                {n.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="flex items-center gap-2 sm:gap-3">
          <button id="theme-btn" type="button" class="rounded-md p-2 text-white/70 transition hover:text-white" aria-label="Toggle dark mode" aria-pressed="false">
            <svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
            <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
          <a
            href="/#join"
            class="hidden rounded-md bg-white px-4 py-2 text-sm font-semibold text-brand-black transition hover:bg-accent-soft hover:text-white sm:inline-block"
          >
            {t('nav.join')}
          </a>
          <button
            id="menu-btn"
            type="button"
            class="rounded-md p-2 text-white lg:hidden"
            aria-label={t('nav.menu')}
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </nav>
      <div id="progress" class="absolute inset-x-0 bottom-0 h-0.5 bg-gradient-to-r from-accent to-accent-soft" aria-hidden="true"></div>
      <div id="mobile-menu" class="hidden border-t border-white/10 bg-brand-black lg:hidden">
        <ul class="mx-auto grid max-w-7xl gap-1 px-5 py-4 text-base font-medium">
          {nav.map((n) => (
            <li><a href={n.href} class="block rounded-md px-3 py-2 hover:bg-white/10">{n.label}</a></li>
          ))}
          <li><a href="/#join" class="block rounded-md px-3 py-2 font-semibold text-accent-soft hover:bg-white/10">{t('nav.join')}</a></li>
        </ul>
      </div>
    </header>

    <main id="top" tabindex="-1">
      <slot />
    </main>

    <footer class="border-t border-white/10 bg-[#111111] text-white/60">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-3">
        <div>
          <img src="/logo-white.png" alt="CELOS" class="h-6 w-auto" width="720" height="164" loading="lazy" />
          <p class="mt-4 text-sm">Control, Estimation, and Learning for Optimal Systems</p>
        </div>
        <div class="text-sm leading-relaxed">
          <p>{t('footer.address')}</p>
          <p class="mt-2"><a href={`mailto:${links.email}`} class="hover:text-white">{links.email}</a></p>
        </div>
        <ul class="flex flex-wrap gap-5 text-sm md:justify-end">
          <li><a href={links.youtube} class="inline-flex items-center gap-1.5 hover:text-white"><BrandIcon name="youtube" brand={false} /> YouTube</a></li>
          <li><a href={links.blog} class="inline-flex items-center gap-1.5 hover:text-white"><BrandIcon name="blog" brand={false} /> Tech Blog</a></li>
          <li><a href={links.linkedin} class="inline-flex items-center gap-1.5 hover:text-white"><BrandIcon name="linkedin" brand={false} /> LinkedIn</a></li>
        </ul>
      </div>
      <p class="border-t border-white/10 py-6 text-center font-mono text-xs text-white/60">
        © {new Date().getFullYear()} CELOS Lab, Hanyang University
      </p>
    </footer>

    <a
      id="to-top"
      href="#top"
      aria-label="Back to top"
      class="pointer-events-none fixed right-4 bottom-4 z-40 grid h-11 w-11 place-items-center rounded-full bg-brand-navy text-white opacity-0 shadow-lg shadow-black/40 ring-1 ring-white/20 transition hover:bg-accent sm:right-6 sm:bottom-6"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
    </a>

    <script>
      // Mobile menu, scroll reveal, active nav item, video playback, back-to-top button.
      const themeBtn = document.getElementById('theme-btn')!;
      const root = document.documentElement;
      themeBtn.setAttribute('aria-pressed', String(root.classList.contains('dark')));
      themeBtn.addEventListener('click', () => {
        const dark = root.classList.toggle('dark');
        themeBtn.setAttribute('aria-pressed', String(dark));
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });

      const btn = document.getElementById('menu-btn')!;
      const menu = document.getElementById('mobile-menu')!;
      btn.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });
      menu.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        }),
      );

      document.querySelectorAll<HTMLButtonElement>('[data-collapse-btn]').forEach((b) => {
        const box = b.closest('[data-collapsible]')!;
        const more = b.textContent ?? '';
        b.addEventListener('click', () => {
          const open = box.toggleAttribute('data-open');
          b.textContent = open ? b.dataset.less ?? '' : more;
        });
      });

      // Play clips only while on screen. Data saver keeps the posters.
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
      const player = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }),
        { rootMargin: '100px 0px' },
      );
      if (!saveData) {
        document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => player.observe(v));
      }

      const toTop = document.getElementById('to-top')!;
      const progress = document.getElementById('progress')!;
      const onScroll = () => {
        const on = window.scrollY > 700;
        toTop.classList.toggle('opacity-0', !on);
        toTop.classList.toggle('pointer-events-none', !on);
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Numbers marked data-count count up from 0 when they come into view (the HTML keeps the final value).
      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min((now - start) / 1200, 1);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const counter = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          countUp(e.target as HTMLElement);
          counter.unobserve(e.target);
        }),
        { threshold: 0.6 },
      );
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => counter.observe(el));

      const reveal = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            reveal.unobserve(e.target);
          }
        }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));

      const links = new Map(
        [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav!, a]),
      );
      const spy = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.classList.remove('text-white!', 'font-semibold'));
          links.get(e.target.id)?.classList.add('text-white!', 'font-semibold');
        }),
        { rootMargin: '-45% 0px -50% 0px' },
      );
      links.forEach((_, id) => {
        const section = document.getElementById(id);
        if (section) spy.observe(section);
      });
    </script>
  </body>
</html>
